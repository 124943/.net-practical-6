@model List<Product_Catalog.Models.Product>

@{
    ViewBag.Title = "Product List";
}

<h2>Product List</h2>

<table border="1" cellpadding="10" cellspacing="0">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Description</th>
        <th>Category</th>
        <th>Price</th>
        <th>Action</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Name</td>
            <td>@p.Description</td>
            <td>@p.Category</td>
            <td>@p.Price</td>
            <td>
                @Html.ActionLink("View", "Details", new { id = p.Id })
            </td>
        </tr>
    }
</table>
